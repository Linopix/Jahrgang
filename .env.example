# Kopieren nach .env. Compose liest die Datei nicht als env_file,
# sondern ersetzt ${VARIABLEN} in docker-compose.yml und compose.dev.yml.
# Ohne Einträge läuft das Spiel mit iTunes- und Deezer-Vorschau.

# Host-Port. Im Container bleibt 8080.
# JAHRGANG_PORT=8080

# Nur mit Profil db. Passwort gilt nur für diesen lokalen Container.
# docker compose --profile db up --build -d
# DATABASE_URL=postgres://jahrgang:jahrgang@db:5432/jahrgang

# Spotify ist optional und im Code oft aus (SPOTIFY_LIVE).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/api/spotify/callback
# SPOTIFY_MARKET=DE
